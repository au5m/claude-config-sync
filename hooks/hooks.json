{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/config-sync-check.sh\" --start",
            "timeout": 10
          }
        ]
      }
